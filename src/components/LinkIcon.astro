---
// Iconos de marca de los enlaces. Compartido por enlaces activos y deshabilitados.
interface Props {
  icon?: string;
}

const { icon } = Astro.props;
---
  {icon === 'book' && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 4h6l2 2 2-2h6v15h-6l-2 2-2-2H4zM12 6v15" />
    </svg>
  )}
  {icon === 'calendar' && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="17" rx="3" />
      <path d="M16 2v4M8 2v4M3 9.5h18" />
      <circle cx="12" cy="15" r="3.2" />
      <path d="M12 13.5V15l1.4 1" />
    </svg>
  )}
  {icon === 'whatsapp' && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
      <path
        fill="#25D366"
        d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"
      />
      <path
        fill="#FFFFFF"
        d="M17.52 14.33c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.48-.88-.78-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.21-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.48 1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"
      />
    </svg>
  )}
  {icon === 'instagram' && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
      <defs>
        <radialGradient id="ig-grad" cx="20%" cy="110%" r="140%">
          <stop offset="0%" stop-color="#FEC053" />
          <stop offset="10%" stop-color="#FEC053" />
          <stop offset="50%" stop-color="#F2203E" />
          <stop offset="100%" stop-color="#A200B9" />
        </radialGradient>
      </defs>
      <rect x="2" y="2" width="20" height="20" rx="5.5" fill="url(#ig-grad)" />
      <rect x="5.2" y="5.2" width="13.6" height="13.6" rx="3.4" fill="none" stroke="#FFFFFF" stroke-width="1.6" />
      <circle cx="12" cy="12" r="3.4" fill="none" stroke="#FFFFFF" stroke-width="1.6" />
      <circle cx="16.2" cy="7.8" r="0.8" fill="#FFFFFF" />
    </svg>
  )}
  {icon === 'tiktok' && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation" fill="currentColor">
      <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
    </svg>
  )}
  {icon === 'facebook' && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
      <path
        fill="#1877F2"
        d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
      />
    </svg>
  )}
  {icon === 'review' && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
      <path
        fill="#FBBC04"
        d="M12 2.2l2.84 6.06 6.66.88-4.87 4.62 1.22 6.6-5.85-3.18-5.85 3.18 1.22-6.6L2.5 9.14l6.66-.88L12 2.2z"
      />
    </svg>
  )}
  {icon === 'promotions' && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 7.5V4h16v3.5a2.5 2.5 0 0 0 0 5V16H4v-3.5a2.5 2.5 0 0 0 0-5Z" />
      <path d="m14.5 7.5-5 6M9.2 7.5h.01M14.8 13.5h.01" />
    </svg>
  )}
  {icon === 'location' && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
      <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7z" fill="#EA4335" />
      <path d="M5 9c0 1.8.6 3.4 1.7 4.8L12 6.5V2A7 7 0 0 0 5 9z" fill="#4285F4" />
      <path d="M12 22s2.6-2.9 4.3-6.2L12 12.5V22z" fill="#34A853" />
      <path d="M17.3 13.8c1.1-1.4 1.7-3 1.7-4.8 0-1.9-.7-3.6-2-4.9L12 9.5v3l5.3 1.3z" fill="#FBBC04" />
      <circle cx="12" cy="9" r="3" fill="#FFFFFF" />
      <circle cx="12" cy="9" r="1.8" fill="#1A73E8" />
    </svg>
  )}
  {(icon === 'mail' || icon === 'gmail') && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
      <rect x="1.5" y="1.5" width="21" height="21" rx="5" fill="#ffffff" />
      <svg x="3.5" y="4.5" width="17" height="15" viewBox="0 49.4 512 399.42">
        <path fill="#4285F4" d="M34.91 448.818h81.454V251L0 163.727V413.91c0 19.287 15.622 34.91 34.91 34.91z" />
        <path fill="#34A853" d="M395.636 448.818h81.455c19.287 0 34.909-15.622 34.909-34.909V163.727L395.636 251z" />
        <path fill="#FBBC04" d="M395.636 99.727V251L512 163.727v-46.545c0-43.142-49.25-67.782-83.782-41.891z" />
        <path fill="#EA4335" d="M116.364 251V99.727L256 204.455 395.636 99.727V251L256 355.727z" />
        <path fill="#C5221F" d="M0 117.182v46.545L116.364 251V99.727L83.782 75.291C49.25 49.4 0 74.04 0 117.18z" />
      </svg>
    </svg>
  )}
  {(icon === 'team' || icon === 'contact') && (
    <svg viewBox="0 0 24 24" class="brand-svg" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
      <circle cx="9" cy="7" r="4" />
      <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
      <path d="M16 3.13a4 4 0 0 1 0 7.75" />
    </svg>
  )}
