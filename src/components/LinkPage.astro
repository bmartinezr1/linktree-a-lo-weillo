---
import { site } from '../data/site';
import '../styles/global.css';

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site.description} />
    <link rel="icon" type="image/png" href={site.logo} />
    <title>{site.name}</title>
  </head>
  <body>
    <main class="page-shell">
      <article class="profile" aria-labelledby="business-name">
        <img class="logo" src={site.logo} alt={`Logo de ${site.name}`} width="512" height="512" />
        <h1 id="business-name">{site.name}</h1>
        <p class="tagline">{site.tagline}</p>
        <p class="description">{site.description}</p>

        <nav class="links" aria-label={`Enlaces de ${site.name}`}>
          {site.links.map((link) => (
            <a class="link-button" href={link.href} target="_blank" rel="noopener noreferrer">
              <span class="link-icon" aria-hidden="true">
                {link.icon === 'instagram' && (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle class="icon-dot" cx="17.5" cy="6.5" r="0.8" />
                  </svg>
                )}
                {link.icon === 'review' && (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <path d="m12 3 2.78 5.63 6.22.9-4.5 4.38 1.06 6.2L12 17.18 6.44 20.1l1.06-6.2L3 9.53l6.22-.9L12 3Z" />
                  </svg>
                )}
                {link.icon === 'location' && (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.6" />
                  </svg>
                )}
              </span>
              <span>{link.label}</span>
            </a>
          ))}
        </nav>

        <p class="footer">Tu estilo es nuestra prioridad.</p>
      </article>
    </main>
  </body>
</html>
