---
import GoogleAnalytics from './GoogleAnalytics.astro';
import { site as defaultSite, type SiteProfile } from '../data/site';
import { validateSite } from '../data/validate-site';
import TransferButton from './TransferButton.astro';
import LinkIcon from './LinkIcon.astro';
import '../styles/global.css';
import '../styles/comercio-panel.css';

interface Props {
  site?: SiteProfile;
  profile?: SiteProfile;
}

const site: SiteProfile = Astro.props.site ?? Astro.props.profile ?? defaultSite;
// Pilot rollout: expand only after the bakery page is approved.
const usePanelComercio = site.theme === 'comercio' && site.slug === 'panaderia-y-pasteleria-saez-hidalgo';
const transfers = site.transfer ? (Array.isArray(site.transfer) ? site.transfer : [site.transfer]) : [];
validateSite(site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageUrl = site.logo ? new URL(site.logo, Astro.site ?? Astro.url) : undefined;
const typography = site.typography ?? 'inter';
const typographyStyles: Record<string, { family: string; google?: string }> = {
  inter: { family: "'Inter', ui-sans-serif, system-ui, sans-serif", google: 'Inter:wght@400;500;600;700' },
  poppins: { family: "'Poppins', ui-sans-serif, system-ui, sans-serif", google: 'Poppins:wght@400;500;600;700' },
  montserrat: { family: "'Montserrat', ui-sans-serif, system-ui, sans-serif", google: 'Montserrat:wght@400;500;600;700' },
  roboto: { family: "'Roboto', ui-sans-serif, system-ui, sans-serif", google: 'Roboto:wght@400;500;700' },
  'plus-jakarta-sans': { family: "'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif", google: 'Plus+Jakarta+Sans:wght@400;500;600;700' },
  outfit: { family: "'Outfit', ui-sans-serif, system-ui, sans-serif", google: 'Outfit:wght@400;500;600;700' },
  'playfair-display': { family: "'Playfair Display', Georgia, serif", google: 'Playfair+Display:wght@400;600;700' },
  merriweather: { family: "'Merriweather', Georgia, serif", google: 'Merriweather:wght@400;700' },
  oswald: { family: "'Oswald', Impact, sans-serif", google: 'Oswald:wght@400;600;700' },
  system: { family: "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" },
};
const font = typographyStyles[typography] ?? typographyStyles.inter;
const googleFontUrl = font.google
  ? 'https://fonts.googleapis.com/css2?family=' + font.google + '&display=swap'
  : undefined;
const customStyle = site.colors
  ? '--background:' + site.colors.background + ';--surface:' + site.colors.button +
    ';--surface-hover:' + site.colors.button + ';--gold:' + (site.colors.accent ?? site.colors.button) +
    ';--gold-light:' + (site.colors.accent ?? site.colors.button) + ';--border:' + site.colors.button +
    ';--text:' + site.colors.text + ';--muted:' + site.colors.text + ';--button-text:' +
    site.colors.buttonText + ';--page-font:' + font.family + ';--logo-width:' +
    (site.logoWidth ?? 160) + 'px;'
  : undefined;
const faviconType = site.favicon?.endsWith('.jpg') || site.favicon?.endsWith('.jpeg')
  ? 'image/jpeg'
  : (site.favicon?.endsWith('.svg') ? 'image/svg+xml' : (site.favicon?.endsWith('.webp') ? 'image/webp' : 'image/png'));
---

<!doctype html>
<html lang="es" style={usePanelComercio ? customStyle : undefined}>
  <head>
    <GoogleAnalytics />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={site.description} />
    {googleFontUrl && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {googleFontUrl && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {googleFontUrl && <link href={googleFontUrl} rel="stylesheet" />}
    <meta name="theme-color" content={site.colors?.background ?? '#080808'} />
    <link rel="icon" type={faviconType} href={site.favicon} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={site.logoAlt ?? `Logo de ${site.name}`} />}
    <meta property="og:type" content="website" />
    <title>{site.name}</title>
  </head>
  <body class={`business-page ${site.colors ? 'generated-page' : ''} theme-${site.theme ?? 'barber'} ${usePanelComercio ? 'comercio-panel' : ''}`} style={customStyle}>
    <main class="page-shell">
      <article class="profile" aria-labelledby="business-name">
        <header
          class={`profile-header ${site.heroBanner ? 'profile-header-brand-background' : ''}`}
          style={site.heroBanner ? `--brand-hero-image: url('${site.heroBanner}')` : undefined}
        >
          <slot name="profile-image">
          {site.logo ? (
            <img
              class={['logo', (site.logoLayout === 'poster' || site.logoLayout === 'original' ? 'logo-poster' : ''), (site.logoLayout === 'round' ? 'logo-round' : ''), (site.logoLayout === 'rounded' ? 'logo-rounded' : '')].filter(Boolean).join(' ')}
              src={site.logo}
              alt={site.logoAlt ?? `Logo de ${site.name}`}
              width={site.logoWidth ?? 512}
              height={site.logoHeight ?? 512}
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="logo logo-monogram" role="img" aria-label={`Identidad visual de ${site.name}`}>
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <g class="flower-petals">
                  <ellipse cx="60" cy="28" rx="15" ry="25" />
                  <ellipse cx="60" cy="92" rx="15" ry="25" />
                  <ellipse cx="28" cy="60" rx="25" ry="15" />
                  <ellipse cx="92" cy="60" rx="25" ry="15" />
                  <ellipse cx="37" cy="37" rx="14" ry="24" transform="rotate(-45 37 37)" />
                  <ellipse cx="83" cy="37" rx="14" ry="24" transform="rotate(45 83 37)" />
                  <ellipse cx="37" cy="83" rx="14" ry="24" transform="rotate(45 37 83)" />
                  <ellipse cx="83" cy="83" rx="14" ry="24" transform="rotate(-45 83 83)" />
                </g>
                <circle cx="60" cy="60" r="25" />
              </svg>
              <span>{site.monogram}</span>
            </div>
          )}
          </slot>
          <h1 id="business-name">{site.name}</h1>
          {site.tagline && <p class="tagline">{site.tagline}</p>}
        </header>

        {site.description && site.theme !== 'recargas-ac' && (site.theme !== 'comercio' || usePanelComercio) && (
          <p class="profile-description">{site.description}</p>
        )}

        {site.branches && site.branches.length > 0 && (
          <section class="branches-showcase" aria-labelledby="branches-heading">
            <h2 id="branches-heading" class="branches-heading">Nuestras sucursales</h2>
            <div class="branches-grid">
              {site.branches.map((branch) => (
                <article class="branch-card" aria-labelledby={`branch-name-${branch.id}`}>
                  <div class="branch-card-body">
                    <h3 id={`branch-name-${branch.id}`} class="branch-name">{branch.name}</h3>

                    <div class="branch-details">
                      <div class="branch-detail-item">
                        <span class="branch-detail-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z" />
                            <circle cx="12" cy="10" r="2.8" />
                          </svg>
                        </span>
                        <div class="branch-detail-text">
                          <span class="branch-detail-label">Dirección</span>
                          <p class="branch-detail-value">{branch.address}</p>
                        </div>
                      </div>

                      <div class="branch-detail-item">
                        <span class="branch-detail-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" />
                            <polyline points="12 7 12 12 15.5 14" />
                          </svg>
                        </span>
                        <div class="branch-detail-text">
                          <span class="branch-detail-label">Horario</span>
                          <p class="branch-detail-value">{branch.schedule}</p>
                        </div>
                      </div>
                    </div>

                    <div class="branch-actions">
                      {branch.reviewUrl && (
                        <a
                          class="branch-action-button branch-btn-review"
                          href={branch.reviewUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`Dejar una reseña para ${branch.name}`}
                        >
                          <span class="branch-action-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
                              <path
                                fill="#FBBC04"
                                d="M12 2.2l2.84 6.06 6.66.88-4.87 4.62 1.22 6.6-5.85-3.18-5.85 3.18 1.22-6.6L2.5 9.14l6.66-.88L12 2.2z"
                              />
                            </svg>
                          </span>
                          <span>Dejar reseña</span>
                        </a>
                      )}
                      {branch.locationUrl && (
                        <a
                          class="branch-action-button branch-btn-location"
                          href={branch.locationUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`Cómo llegar a ${branch.name}`}
                        >
                          <span class="branch-action-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
                              <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7z" fill="#EA4335" />
                              <path d="M5 9c0 1.8.6 3.4 1.7 4.8L12 6.5V2A7 7 0 0 0 5 9z" fill="#4285F4" />
                              <path d="M12 22s2.6-2.9 4.3-6.2L12 12.5V22z" fill="#34A853" />
                              <path d="M17.3 13.8c1.1-1.4 1.7-3 1.7-4.8 0-1.9-.7-3.6-2-4.9L12 9.5v3l5.3 1.3z" fill="#FBBC04" />
                              <circle cx="12" cy="9" r="3" fill="#FFFFFF" />
                              <circle cx="12" cy="9" r="1.8" fill="#1A73E8" />
                            </svg>
                          </span>
                          <span>Cómo llegar</span>
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        {(site.highlights.length > 0 || (site.contactDetails?.length ?? 0) > 0) && (
          <section class:list={['info-showcase', { 'info-showcase-contact-only': site.highlights.length === 0 }]} aria-label={`Información de ${site.name}`}>
            {site.highlights.map((item) => (
              <div class={`info-item info-item-${item.id}`}>
                <span class="info-icon" aria-hidden="true">
                  {(item.icon === 'location' || item.id === 'location') && (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z" />
                      <circle cx="12" cy="10" r="2.8" />
                    </svg>
                  )}
                  {(item.icon === 'scissors' || item.id === 'cuts') && (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <circle cx="6" cy="6" r="3" />
                      <circle cx="6" cy="18" r="3" />
                      <line x1="20" y1="4" x2="8.12" y2="15.88" />
                      <line x1="14.8" y1="14.8" x2="20" y2="20" />
                      <line x1="8.12" y1="8.12" x2="12" y2="12" />
                      <circle class="icon-dot" cx="12" cy="12" r="1.3" />
                    </svg>
                  )}
                  {(item.icon === 'calendar' || item.id === 'booking') && (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <rect x="3" y="4" width="18" height="17" rx="3" />
                      <line x1="16" y1="2" x2="16" y2="6" />
                      <line x1="8" y1="2" x2="8" y2="6" />
                      <line x1="3" y1="9.5" x2="21" y2="9.5" />
                      <circle cx="12" cy="15" r="3.2" />
                      <polyline points="12 13.5 12 15 13.4 15" />
                    </svg>
                  )}
                  {item.icon === 'flower' && (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <path d="M12 10.2c-2.9-4.7-7.4-3.4-7.4-.2 0 2.7 3.5 3.4 5.3 2.5-1.8 1-2.6 4.5-.2 5.8 2.8 1.5 4.6-1.9 4.1-4 1.4 1.5 5 1.5 5.6-1.2.7-3.1-3.6-4.6-6.1-2.5 2.4-2.3 4.1-6.3 1.4-7.5-2.7-1.2-5 2.7-3.2 5.3Z" />
                      <circle cx="12" cy="10.2" r="2.2" />
                      <path d="M12 12.4v8M12 17c-2.4-2-4.1-1.8-5.2-.8M12 18.6c2.1-1.8 3.9-1.5 5-.5" />
                    </svg>
                  )}
                  {(item.icon === 'schedule' || item.id === 'schedule') && (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <circle cx="12" cy="12" r="9" />
                      <polyline points="12 7 12 12 15.5 14" />
                    </svg>
                  )}
                  {(item.icon === 'payments' || item.id === 'payments') && (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <line x1="3" y1="10" x2="21" y2="10" />
                      <line x1="7" y1="15" x2="10" y2="15" />
                    </svg>
                  )}
                  {(item.icon === 'contact' || item.id === 'contact') && (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <path d="M5 4h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-5l-3 3v-3H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                      <path d="M7 8h10M7 12h6" />
                    </svg>
                  )}
                  {item.icon === 'wrench' && (
                    <svg viewBox="0 0 24 24" role="presentation">
                      <path d="M14.7 6.3a5 5 0 0 0-6.5 6.5l-5.3 5.3a2 2 0 0 0 2.8 2.8l5.3-5.3a5 5 0 0 0 6.5-6.5l-3.2 3.2-2.9-.6-.6-2.9 3.2-3.2Z" />
                    </svg>
                  )}
                </span>
                <div class="info-content">
                  <span class="info-label">{item.label}</span>
                  {item.value && <p class="info-value">{item.value}</p>}
                  {item.items && item.items.length > 0 && (
                    <ul class="info-bullet-grid">
                      {item.items.map((service) => <li>{service}</li>)}
                    </ul>
                  )}
                </div>
              </div>
            ))}
            {site.contactDetails && site.contactDetails.length > 0 && (
              <div class="info-item info-item-contact">
                <span class="info-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" role="presentation">
                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 3.1 5.2 2 2 0 0 1 5.1 3h3a2 2 0 0 1 2 1.7l.5 2.8a2 2 0 0 1-.6 1.8L8.2 11a16 16 0 0 0 4.8 4.8l1.7-1.8a2 2 0 0 1 1.8-.6l2.8.5a2 2 0 0 1 1.7 2Z" />
                  </svg>
                </span>
                <div class="info-content">
                  <span class="info-label">Contacto</span>
                  {site.contactDetails.map((contact) => (
                    <a class="info-value contact-detail" href={contact.href}>{contact.label}</a>
                  ))}
                </div>
              </div>
            )}
          </section>
        )}

        <nav class:list={['links', { 'links-7e': site === defaultSite }]} aria-label={`Enlaces y acciones de ${site.name}`}>
          <slot name="before-links" />
          {site.links.map((link, index) => (
            <>
            {link.copyText ? (
              <TransferButton details={{ text: link.copyText, logo: link.logo ?? undefined }} label={link.label} statusId={`transfer-link-${index}`} />
            ) : link.isDisabled ? (
              <span
                class={`link-button link-button-disabled ${link.icon === 'whatsapp' ? 'link-button-whatsapp' : ''} ${link.icon === 'facebook' ? 'link-button-facebook' : ''}`}
                aria-disabled="true"
              >
                <span class="link-icon" aria-hidden="true">
                  <LinkIcon icon={link.icon} />
                </span>
                <span>{link.label}</span>
              </span>
            ) : (
            <a
              class={`link-button ${link.icon === 'whatsapp' ? 'link-button-whatsapp' : ''} ${link.icon === 'facebook' ? 'link-button-facebook' : ''} ${link.icon === 'promotions' ? 'link-button-promotions' : ''} ${link.icon === 'review' ? 'link-button-review' : ''}`}
              href={link.href}
              target={link.href?.startsWith('/') ? undefined : '_blank'}
              rel={link.href?.startsWith('/') ? undefined : 'noopener noreferrer'}
            >
              <span class="link-icon" aria-hidden="true">
                <LinkIcon icon={link.icon} />
              </span>
              <span>{link.label}</span>
            </a>
            )}
            {link.icon === 'tiktok' && <slot name="after-tiktok" />}
            </>
          ))}
          {transfers.map((details, index) => (
            <TransferButton details={details} statusId={`transfer-status-${index}`} />
          ))}
        </nav>
        <slot name="after-links" />

        {site.productShowcase && (
          <section class="product-showcase" aria-labelledby="product-showcase-heading">
            <h2 id="product-showcase-heading">{site.productShowcase.heading}</h2>
            <ul class="product-showcase-list">
              {site.productShowcase.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {site.barbers && site.barbers.length > 0 && (
          <section class="team-showcase" aria-label="Equipo de barberos">
            <h2 class="team-heading">💈 Conoce a nuestros Barberos</h2>
            <div class="team-list">
              {site.barbers.map((barber) => (
                <a class="barber-card" href={barber.href}>
                  <img
                    class="barber-avatar"
                    src={barber.avatar}
                    alt={`Foto de ${barber.name}`}
                    width="64"
                    height="64"
                    loading="lazy"
                  />
                  <div class="barber-info">
                    <span class="barber-name">{barber.name}</span>
                    <span class="barber-role">{barber.role}</span>
                  </div>
                  <span class="barber-action" aria-hidden="true">
                    {barber.badge && <span class="barber-badge">{barber.badge}</span>}
                    <svg viewBox="0 0 24 24" class="barber-chevron" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

        {site.footer !== '' && <p class="footer">{site.footer ?? 'Tu estilo es nuestra prioridad.'}</p>}
        <p class="footer footer-powered-by"><a href="/" aria-label="Conoce ClickTap, tarjetas NFC y páginas digitales para negocios">Powered by ClickTap</a></p>
      </article>
    </main>
  </body>
</html>

