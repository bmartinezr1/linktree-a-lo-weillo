---
import { site as defaultSite, type SiteProfile } from '../data/site';
import { validateSite } from '../data/validate-site';
import TransferButton from './TransferButton.astro';
import '../styles/global.css';

interface Props {
  site?: SiteProfile;
  profile?: SiteProfile;
}

const site: SiteProfile = Astro.props.site ?? Astro.props.profile ?? defaultSite;
validateSite(site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const imageUrl = site.logo ? new URL(site.logo, Astro.site ?? Astro.url) : undefined;
const faviconType = site.favicon?.endsWith('.jpg') || site.favicon?.endsWith('.jpeg')
  ? 'image/jpeg'
  : (site.favicon?.endsWith('.svg') ? 'image/svg+xml' : (site.favicon?.endsWith('.webp') ? 'image/webp' : 'image/png'));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#080808" />
    <link rel="icon" type={faviconType} href={site.favicon} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={site.logoAlt ?? `Logo de ${site.name}`} />}
    <meta property="og:type" content="website" />
    <title>{site.name}</title>
  </head>
  <body class={`business-page theme-${site.theme ?? 'barber'}`}>
    <main class="page-shell">
      <article class="profile" aria-labelledby="business-name">
        <header class="profile-header">
          {site.logo ? (
            <img
              class="logo"
              src={site.logo}
              alt={site.logoAlt ?? `Logo de ${site.name}`}
              width="512"
              height="512"
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="logo logo-monogram" role="img" aria-label={`Identidad visual de ${site.name}`}>
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <g class="flower-petals">
                  <ellipse cx="60" cy="28" rx="15" ry="25" />
                  <ellipse cx="60" cy="92" rx="15" ry="25" />
                  <ellipse cx="28" cy="60" rx="25" ry="15" />
                  <ellipse cx="92" cy="60" rx="25" ry="15" />
                  <ellipse cx="37" cy="37" rx="14" ry="24" transform="rotate(-45 37 37)" />
                  <ellipse cx="83" cy="37" rx="14" ry="24" transform="rotate(45 83 37)" />
                  <ellipse cx="37" cy="83" rx="14" ry="24" transform="rotate(45 37 83)" />
                  <ellipse cx="83" cy="83" rx="14" ry="24" transform="rotate(-45 83 83)" />
                </g>
                <circle cx="60" cy="60" r="25" />
              </svg>
              <span>{site.monogram}</span>
            </div>
          )}
          <h1 id="business-name">{site.name}</h1>
          {site.tagline && <p class="tagline">{site.tagline}</p>}
        </header>

        <section class="info-showcase" aria-label={`Información de ${site.name}`}>
          {site.highlights.map((item) => (
            <div class={`info-item info-item-${item.id}`}>
              <span class="info-icon" aria-hidden="true">
                {(item.icon === 'location' || item.id === 'location') && (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <path d="M20 10c0 5.2-8 11-8 11S4 15.2 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.8" />
                  </svg>
                )}
                {(item.icon === 'scissors' || item.id === 'cuts') && (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <circle cx="6" cy="6" r="3" />
                    <circle cx="6" cy="18" r="3" />
                    <line x1="20" y1="4" x2="8.12" y2="15.88" />
                    <line x1="14.8" y1="14.8" x2="20" y2="20" />
                    <line x1="8.12" y1="8.12" x2="12" y2="12" />
                    <circle class="icon-dot" cx="12" cy="12" r="1.3" />
                  </svg>
                )}
                {(item.icon === 'calendar' || item.id === 'booking') && (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <rect x="3" y="4" width="18" height="17" rx="3" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="9.5" x2="21" y2="9.5" />
                    <circle cx="12" cy="15" r="3.2" />
                    <polyline points="12 13.5 12 15 13.4 15" />
                  </svg>
                )}
                {item.icon === 'flower' && (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <path d="M12 10.2c-2.9-4.7-7.4-3.4-7.4-.2 0 2.7 3.5 3.4 5.3 2.5-1.8 1-2.6 4.5-.2 5.8 2.8 1.5 4.6-1.9 4.1-4 1.4 1.5 5 1.5 5.6-1.2.7-3.1-3.6-4.6-6.1-2.5 2.4-2.3 4.1-6.3 1.4-7.5-2.7-1.2-5 2.7-3.2 5.3Z" />
                    <circle cx="12" cy="10.2" r="2.2" />
                    <path d="M12 12.4v8M12 17c-2.4-2-4.1-1.8-5.2-.8M12 18.6c2.1-1.8 3.9-1.5 5-.5" />
                  </svg>
                )}
                {(item.icon === 'schedule' || item.id === 'schedule') && (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <circle cx="12" cy="12" r="9" />
                    <polyline points="12 7 12 12 15.5 14" />
                  </svg>
                )}
                {(item.icon === 'payments' || item.id === 'payments') && (
                  <svg viewBox="0 0 24 24" role="presentation">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                    <line x1="7" y1="15" x2="10" y2="15" />
                  </svg>
                )}
              </span>
              <div class="info-content">
                <span class="info-label">{item.label}</span>
                <p class="info-value">{item.value}</p>
              </div>
            </div>
          ))}
        </section>

        <nav class:list={['links', { 'links-7e': site === defaultSite }]} aria-label={`Enlaces y acciones de ${site.name}`}>
          {site.links.map((link) => (
            link.isDisabled ? (
              <span
                class={`link-button link-button-disabled ${link.icon === 'whatsapp' ? 'link-button-whatsapp' : ''} ${link.icon === 'facebook' ? 'link-button-facebook' : ''}`}
                aria-disabled="true"
              >
                <span class="link-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="brand-svg" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                  </svg>
                </span>
                <span>{link.label}</span>
              </span>
            ) : (
            <a
              class={`link-button ${link.icon === 'whatsapp' ? 'link-button-whatsapp' : ''} ${link.icon === 'facebook' ? 'link-button-facebook' : ''} ${link.icon === 'promotions' ? 'link-button-promotions' : ''}`}
              href={link.href}
              target={link.href.startsWith('/') ? undefined : '_blank'}
              rel={link.href.startsWith('/') ? undefined : 'noopener noreferrer'}
            >
              <span class="link-icon" aria-hidden="true">
                {link.icon === 'calendar' && (
                  <svg viewBox="0 0 24 24" class="brand-svg" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="17" rx="3" />
                    <path d="M16 2v4M8 2v4M3 9.5h18" />
                    <circle cx="12" cy="15" r="3.2" />
                    <path d="M12 13.5V15l1.4 1" />
                  </svg>
                )}
                {link.icon === 'whatsapp' && (
                  <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
                    <path
                      fill="#25D366"
                      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2z"
                    />
                    <path
                      fill="#FFFFFF"
                      d="M17.52 14.33c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.48-.88-.78-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.91-2.21-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.48 1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"
                    />
                  </svg>
                )}
                {link.icon === 'instagram' && (
                  <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
                    <defs>
                      <radialGradient id="ig-grad" cx="20%" cy="110%" r="140%">
                        <stop offset="0%" stop-color="#FEC053" />
                        <stop offset="10%" stop-color="#FEC053" />
                        <stop offset="50%" stop-color="#F2203E" />
                        <stop offset="100%" stop-color="#A200B9" />
                      </radialGradient>
                    </defs>
                    <rect x="2" y="2" width="20" height="20" rx="5.5" fill="url(#ig-grad)" />
                    <rect x="5.2" y="5.2" width="13.6" height="13.6" rx="3.4" fill="none" stroke="#FFFFFF" stroke-width="1.6" />
                    <circle cx="12" cy="12" r="3.4" fill="none" stroke="#FFFFFF" stroke-width="1.6" />
                    <circle cx="16.2" cy="7.8" r="0.8" fill="#FFFFFF" />
                  </svg>
                )}
                {link.icon === 'facebook' && (
                  <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
                    <path
                      fill="#1877F2"
                      d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                    />
                  </svg>
                )}
                {link.icon === 'review' && (
                  <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
                    <path
                      fill="#FBBC04"
                      d="M12 2.2l2.84 6.06 6.66.88-4.87 4.62 1.22 6.6-5.85-3.18-5.85 3.18 1.22-6.6L2.5 9.14l6.66-.88L12 2.2z"
                    />
                  </svg>
                )}
                {link.icon === 'promotions' && (
                  <svg viewBox="0 0 24 24" class="brand-svg" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 7.5V4h16v3.5a2.5 2.5 0 0 0 0 5V16H4v-3.5a2.5 2.5 0 0 0 0-5Z" />
                    <path d="m14.5 7.5-5 6M9.2 7.5h.01M14.8 13.5h.01" />
                  </svg>
                )}
                {link.icon === 'location' && (
                  <svg viewBox="0 0 24 24" class="brand-svg" role="presentation">
                    <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7z" fill="#EA4335" />
                    <path d="M5 9c0 1.8.6 3.4 1.7 4.8L12 6.5V2A7 7 0 0 0 5 9z" fill="#4285F4" />
                    <path d="M12 22s2.6-2.9 4.3-6.2L12 12.5V22z" fill="#34A853" />
                    <path d="M17.3 13.8c1.1-1.4 1.7-3 1.7-4.8 0-1.9-.7-3.6-2-4.9L12 9.5v3l5.3 1.3z" fill="#FBBC04" />
                    <circle cx="12" cy="9" r="3" fill="#FFFFFF" />
                    <circle cx="12" cy="9" r="1.8" fill="#1A73E8" />
                  </svg>
                )}
                {(link.icon === 'team' || link.icon === 'contact') && (
                  <svg viewBox="0 0 24 24" class="brand-svg" role="presentation" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  </svg>
                )}
              </span>
              <span>{link.label}</span>
            </a>
            )
          ))}
          {site.transfer && <TransferButton details={site.transfer} />}
        </nav>

        {site.productShowcase && (
          <section class="product-showcase" aria-labelledby="product-showcase-heading">
            <h2 id="product-showcase-heading">{site.productShowcase.heading}</h2>
            <ul class="product-showcase-list">
              {site.productShowcase.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}

        {site.barbers && site.barbers.length > 0 && (
          <section class="team-showcase" aria-label="Equipo de barberos">
            <h2 class="team-heading">💈 Conoce a nuestros Barberos</h2>
            <div class="team-list">
              {site.barbers.map((barber) => (
                <a class="barber-card" href={barber.href}>
                  <img
                    class="barber-avatar"
                    src={barber.avatar}
                    alt={`Foto de ${barber.name}`}
                    width="64"
                    height="64"
                    loading="lazy"
                  />
                  <div class="barber-info">
                    <span class="barber-name">{barber.name}</span>
                    <span class="barber-role">{barber.role}</span>
                  </div>
                  <span class="barber-action" aria-hidden="true">
                    {barber.badge && <span class="barber-badge">{barber.badge}</span>}
                    <svg viewBox="0 0 24 24" class="barber-chevron" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

        {site.footer !== '' && <p class="footer">{site.footer ?? 'Tu estilo es nuestra prioridad.'}</p>}
      </article>
    </main>
  </body>
</html>

