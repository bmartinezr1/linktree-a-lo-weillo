---
interface Photo { src: string; thumb: string; alt: string; width: number; height: number; }
interface Props { photos: Photo[]; heading?: string; id?: string; }
const { photos, heading = 'Nuestros trabajos', id = 'photo-grid' } = Astro.props;
---
<section class="photo-grid" aria-labelledby={`${id}-heading`} data-photo-grid>
  <h2 id={`${id}-heading`} class="section-heading">{heading}</h2>
  <div class="photo-grid-track">
    {[0, 1].map((copy) => (
      <ul class="photo-grid-list" aria-hidden={copy === 1 ? 'true' : undefined}>
        {photos.map((photo, index) => (
          <li>
            <button type="button" class="photo-grid-item" data-index={index} data-src={photo.src} data-alt={photo.alt} tabindex={copy === 1 ? -1 : undefined} aria-label={`Ver foto ${index + 1} de ${photos.length}`}>
              <img src={photo.thumb} alt={copy === 1 ? '' : photo.alt} width={Math.round(photo.width * 0.6)} height={Math.round(photo.height * 0.6)} loading="eager" decoding="async" />
            </button>
          </li>
        ))}
      </ul>
    ))}
  </div>
  <dialog class="photo-grid-modal" aria-label={heading}>
    <img class="photo-grid-full" alt="" decoding="async" />
    <button type="button" class="photo-grid-nav photo-grid-prev" aria-label="Foto anterior">‹</button>
    <button type="button" class="photo-grid-nav photo-grid-next" aria-label="Foto siguiente">›</button>
    <button type="button" class="photo-grid-close" aria-label="Cerrar">×</button>
    <p class="photo-grid-count" aria-live="polite"></p>
  </dialog>
</section>
<script>
document.querySelectorAll<HTMLElement>('[data-photo-grid]').forEach((grid) => {
  const buttons = [...grid.querySelectorAll<HTMLButtonElement>('.photo-grid-item')];
  const items = buttons.slice(0, buttons.length / 2);
  const modal = grid.querySelector<HTMLDialogElement>('.photo-grid-modal')!;
  const full = grid.querySelector<HTMLImageElement>('.photo-grid-full')!;
  const count = grid.querySelector<HTMLElement>('.photo-grid-count')!;
  let current = 0;
  let startX: number | null = null;
  const show = (index: number) => {
    current = (index + items.length) % items.length;
    const item = items[current];
    full.src = item.dataset.src!;
    full.alt = item.dataset.alt ?? '';
    count.textContent = `${current + 1} / ${items.length}`;
    const next = new Image();
    next.src = items[(current + 1) % items.length].dataset.src!;
  };
  buttons.forEach((item) => item.addEventListener('click', () => { show(Number(item.dataset.index)); modal.showModal(); }));
  grid.querySelector('.photo-grid-prev')!.addEventListener('click', () => show(current - 1));
  grid.querySelector('.photo-grid-next')!.addEventListener('click', () => show(current + 1));
  grid.querySelector('.photo-grid-close')!.addEventListener('click', () => modal.close());
  modal.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
  modal.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
  });
  modal.addEventListener('pointerdown', (event) => { startX = event.clientX; });
  modal.addEventListener('pointerup', (event) => {
    if (startX === null) return;
    const dx = event.clientX - startX;
    startX = null;
    if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
  });
});
</script>
