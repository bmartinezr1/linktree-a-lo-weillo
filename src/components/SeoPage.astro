---
import GoogleAnalytics from './GoogleAnalytics.astro';
interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  eyebrow: string;
  heading: string;
  intro: string;
  image: string;
  imageAlt: string;
  imageWidth: number;
  imageHeight: number;
  breadcrumbs: Breadcrumb[];
  schema: Record<string, unknown> | Record<string, unknown>[];
  ctaTitle?: string;
  ctaText?: string;
  whatsappMessage?: string;
}

const {
  title,
  description,
  canonicalPath,
  eyebrow,
  heading,
  intro,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  breadcrumbs,
  schema,
  ctaTitle = '¿Lo vemos para tu negocio?',
  ctaText = 'Cuéntanos qué quieres facilitar y te ayudamos a elegir el formato que mejor calza.',
  whatsappMessage = 'Hola ClickTap, quiero información para mi negocio.',
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(canonicalPath, baseUrl);
const socialImageUrl = new URL('/clicktap-social.png', baseUrl);
const whatsappUrl = `https://wa.me/56961610609?text=${encodeURIComponent(whatsappMessage)}`;
const pageSchemas = Array.isArray(schema) ? schema : [schema];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://clicktap.app/#organization',
      name: 'ClickTap',
      url: 'https://clicktap.app/',
      logo: 'https://clicktap.app/assets/favicon.svg',
      sameAs: [
        'https://www.instagram.com/clicktap.cl/',
        'https://www.tiktok.com/@clicktap.cl',
      ],
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.label,
        item: item.href ? new URL(item.href, baseUrl).toString() : canonicalUrl.toString(),
      })),
    },
    ...pageSchemas,
  ],
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <GoogleAnalytics />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1559ee" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ClickTap" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tarjetas y soportes NFC ClickTap para negocios" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/seo-pages.css" />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="ClickTap, inicio">clicktap<span>.</span></a>
        <nav aria-label="Navegación principal">
          <a href="/soluciones/resenas-google/">Reseñas Google</a>
          <a href="/productos/soporte-acrilico-nfc-qr/">Soporte personalizado</a>
          <a href="/concepcion/tarjetas-nfc-concepcion/">Concepción</a>
        </nav>
        <a class="button button-dark header-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-conversion="whatsapp">Hablemos <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <main id="contenido">
      <div class="shell">
        <nav class="breadcrumbs" aria-label="Migas de pan">
          {breadcrumbs.map((item, index) => (
            <>
              {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
              {index < breadcrumbs.length - 1 && <i aria-hidden="true">/</i>}
            </>
          ))}
        </nav>
      </div>

      <section class="seo-hero shell">
        <div class="hero-copy">
          <p class="eyebrow">{eyebrow}</p>
          <h1>{heading}</h1>
          <p class="hero-intro">{intro}</p>
          <div class="hero-actions">
            <a class="button button-blue" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-conversion="whatsapp">Consultar por WhatsApp <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="/#productos">Ver los tres formatos</a>
          </div>
        </div>
        <div class="hero-media">
          <span>CLICKTAP · NFC · QR</span>
          <img src={image} alt={imageAlt} width={imageWidth} height={imageHeight} decoding="async" fetchpriority="high" />
        </div>
      </section>

      <slot />

      <section class="closing shell" aria-labelledby="closing-title">
        <p class="eyebrow">CONVERSEMOS</p>
        <h2 id="closing-title">{ctaTitle}</h2>
        <p>{ctaText}</p>
        <a class="button button-white" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-conversion="whatsapp">Escribir a ClickTap <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="brand" href="/">clicktap<span>.</span></a>
        <nav aria-label="Enlaces de ClickTap">
          <a href="/soluciones/resenas-google/">Reseñas de Google</a>
          <a href="/productos/soporte-acrilico-nfc-qr/">Soporte NFC + QR</a>
          <a href="/concepcion/tarjetas-nfc-concepcion/">Tarjetas NFC en Concepción</a>
        </nav>
        <p>Desde Concepción, Chile · <a href="https://www.instagram.com/clicktap.cl/" target="_blank" rel="noopener noreferrer">@clicktap.cl</a></p>
      </div>
    </footer>
  </body>
</html>
