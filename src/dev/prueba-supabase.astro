---
import { createSupabaseClient } from '../lib/supabase';

let mensaje = '';
let nombres: string[] = [];
try {
  const { data, error } = await createSupabaseClient()
    .from('prueba_conexion')
    .select('nombre')
    .limit(5);
  if (error) {
    mensaje = error.code === 'PGRST205'
      ? 'Supabase responde. Falta ejecutar el SQL de prueba en Supabase.'
      : `La consulta no pudo completarse (${error.code || 'red'}). Revisa la configuración y los permisos de la tabla de prueba.`;
  } else {
    nombres = (data ?? []).map((fila) => fila.nombre);
    mensaje = nombres.length ? 'Lectura de Supabase verificada.' : 'Consulta completada sin filas visibles. Revisa el dato de prueba y su política RLS.';
  }
} catch {
  mensaje = 'No se pudo conectar. Revisa el archivo .env y la conexión a Internet.';
}
Astro.response.headers.set('Cache-Control', 'no-store');
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>ClickTap · Prueba Supabase</title>
  </head>
  <body>
    <main>
      <h1>Conexión con Supabase</h1>
      <p>{mensaje}</p>
      <ul>{nombres.map((nombre) => <li>{nombre}</li>)}</ul>
      <p>Prueba local de lectura. Los clientes y negocios se administran desde Laravel.</p>
    </main>
  </body>
</html>
<style>
  body { font-family: system-ui, sans-serif; background: #f5f7fa; color: #182338; padding: 1.5rem; }
  main { max-width: 42rem; margin: 4rem auto; }
</style>
