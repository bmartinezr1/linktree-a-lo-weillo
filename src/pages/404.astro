---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Página no encontrada | ClickTap</title>
  </head>
  <body>
    <main class="page-shell">
      <article class="profile" aria-labelledby="error-title">
        <p class="tagline">Error 404</p>
        <h1 id="error-title">Página no encontrada</h1>
        <p class="info-value">Revisa la dirección del enlace o consulta con el negocio que te lo compartió.</p>
        <a class="link-button" href="/">Ir al inicio de ClickTap</a>
      </article>
    </main>
  </body>
</html>

<style>
  .profile { display: grid; align-content: start; gap: 1.5rem; }
</style>
