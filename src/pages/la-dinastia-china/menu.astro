---
import { laDinastiaChinaSite } from '../../data/site';

const menuImages = [
  {
    src: '/menu-la-dinastia-china-1.jpg',
    alt: 'Primera página del menú de La Dinastía China',
  },
  {
    src: '/menu-la-dinastia-china-2.jpg',
    alt: 'Segunda página del menú de La Dinastía China',
  },
];

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Menú | La Dinastía China</title>
    <meta name="description" content="Menú de La Dinastía China" />
    <link rel="icon" type="image/png" href={laDinastiaChinaSite.favicon} />
  </head>
  <body>
    <main class="menu-page">
      <a class="back-link" href="/la-dinastia-china">← Volver</a>

      <section class="hero">
        <img class="logo" src={laDinastiaChinaSite.logo} alt={laDinastiaChinaSite.name} />
        <p class="eyebrow">Menú</p>
        <h1>{laDinastiaChinaSite.name}</h1>
        <p class="intro">Toca una imagen para verla en tamaño completo.</p>
      </section>

      <section class="menu-images" aria-label="Imágenes del menú">
        {menuImages.map((image, index) => (
          <figure class="menu-card">
            <a href={image.src} target="_blank" rel="noopener noreferrer">
              <img
                src={image.src}
                alt={image.alt}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </a>
            <figcaption>Página {index + 1} de {menuImages.length}</figcaption>
          </figure>
        ))}
      </section>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top, rgba(255, 215, 128, 0.18), transparent 34rem),
      #160b0d;
    color: #fff8df;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  .menu-page {
    width: min(100% - 32px, 1000px);
    margin: 0 auto;
    padding: 32px 0 48px;
  }

  .back-link,
  .order-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: #fff8df;
    text-decoration: none;
    font-weight: 800;
  }

  .back-link {
    margin-bottom: 28px;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.1);
  }

  .hero {
    text-align: center;
    margin-bottom: 28px;
  }

  .logo {
    width: 96px;
    height: 96px;
    border-radius: 999px;
    object-fit: contain;
    background: #fff8df;
    padding: 8px;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.32);
  }

  .eyebrow {
    margin: 18px 0 6px;
    color: #ffd36a;
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 8vw, 4rem);
    line-height: 1;
  }

  .intro {
    margin: 14px auto 0;
    max-width: 560px;
    color: rgba(255, 248, 223, 0.82);
    font-size: 1.05rem;
  }

  .menu-images {
    display: grid;
    gap: 24px;
  }

  .menu-card {
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 211, 106, 0.28);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  .menu-card a {
    display: block;
  }

  .menu-card img {
    display: block;
    width: 100%;
    height: auto;
    background: rgba(255, 255, 255, 0.08);
  }

  figcaption {
    padding: 14px 18px 16px;
    color: rgba(255, 248, 223, 0.78);
    font-size: 0.95rem;
    text-align: center;
  }

  .back-link:focus-visible,
  .menu-card a:focus-visible {
    outline: 3px solid #ffd36a;
    outline-offset: 4px;
  }
</style>
