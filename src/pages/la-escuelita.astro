---
import { getImage } from 'astro:assets';
import LinkPage from '../components/LinkPage.astro';
import type { SiteProfile } from '../data/site';
import logoSource from '../assets/comercializadora-ferrada.jpeg';

const logo = await getImage({ src: logoSource, width: 640, format: 'webp', quality: 90 });
const placeId = 'ChIJ3X1sC7e1aZYRTRIo77PTfn8';
const site: SiteProfile = {
  name: 'La Escuelita',
  tagline: 'Comercial Ferrada',
  description: 'La Escuelita / Comercial Ferrada en Brasil 1549, Concepción, Bío Bío. Encuentra nuestra ubicación, teléfono de contacto y reseñas.',
  theme: 'recargas-ac',
  typography: 'system',
  logo: logo.src,
  logoAlt: 'Logo de Comercializadora Ferrada',
  logoLayout: 'rounded',
  logoWidth: logo.attributes.width,
  logoHeight: logo.attributes.height,
  favicon: logo.src,
  footer: '',
  highlights: [
    {
      id: 'location',
      icon: 'location',
      label: 'Ubicación',
      value: 'Brasil 1549\n4060564 Concepción, Bío Bío',
    },
  ],
  contactDetails: [
    { label: '(41) 293 3391', href: 'tel:+56412933391' },
  ],
  links: [
    {
      label: 'TikTok',
      href: 'https://www.tiktok.com/@comercializadorferrada',
      icon: 'tiktok',
    },
    {
      label: 'Dejar una reseña',
      href: `https://search.google.com/local/writereview?placeid=${placeId}`,
      icon: 'review',
    },
  ],
  transfer: [
    {
      label: 'Copiar datos de transferencia',
      logo: '/logo-bancoestado.svg',
      text: [
        'EJEMPLO — DATOS POR CONFIRMAR',
        'Comercio: La Escuelita / Comercial Ferrada',
        'Titular: [por confirmar]',
        'RUT: [por confirmar]',
        'Banco: BancoEstado',
        'Tipo de cuenta: [por confirmar]',
        'Número de cuenta: [por confirmar]',
        'Correo: [por confirmar]',
      ].join('\n'),
    },
    {
      label: 'Copiar datos de transferencia',
      logo: '/logo-mercado-libre.png',
      text: [
        'EJEMPLO — DATOS POR CONFIRMAR',
        'Comercio: La Escuelita / Comercial Ferrada',
        'Titular: [por confirmar]',
        'RUT: [por confirmar]',
        'Entidad de la cuenta: [por confirmar]',
        'Tipo de cuenta: [por confirmar]',
        'Número de cuenta: [por confirmar]',
        'Correo: [por confirmar]',
      ].join('\n'),
    },
  ],
};
---

<LinkPage site={site} />

<style is:global>
  .theme-recargas-ac .logo.logo-rounded[alt='Logo de Comercializadora Ferrada'] {
    width: clamp(8.5rem, 38vw, 11rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 1rem;
    background: #fff;
    padding: 0.4rem;
    box-shadow: 0 0.75rem 1.75rem rgba(0, 0, 0, 0.25);
  }
</style>
